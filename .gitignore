.aider*

# Remember plugin history
.remember/

# Internal implementation plans / design notes written for agentic workers.
# Kept locally as working notes; not user-facing documentation, so they stay
# out of the published repo.
docs/superpowers/

# mypy cache
.mypy_cache/

# RuVector runtime DB (built locally by analysis agents, never committed)
ruvector.db

# Browser-driven smoke-test artifacts (Chrome MCP saves screenshots/HTML
# captures keyed by frame number — purely local debug output). Match
# both extensionless dumps and the four common extensions Chrome MCP
# emits — the [a-z]* suffix catches free-form names like 107-kling,
# 113-mid, 117-mid-clean, etc.
[0-9][0-9][0-9]-*

# Local-only README variants for the openwebui.com community portal
# listing (Markdown + plain-text). Kept out of the repo so the canonical
# README.md stays the single source of truth on GitHub.
README.owui.md
README.owui.txt
